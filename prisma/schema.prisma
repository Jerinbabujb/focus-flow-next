// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js" // ✅ Fixed provider name
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum DebtType {
  OWED_TO_ME
  I_OWE_OTHERS
}

enum GroceryCategory {
  PRODUCE
  DAIRY
  BAKERY
  MEAT
  PANTRY
  FROZEN
  HOUSEHOLD
  OTHER
}


model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  password      String
  createdAt     DateTime       @default(now())
  tasks         Task[]
  groceryItems  GroceryItem[]
  expenses      Expense[]
  debts         Debt[]
  billArchives  BillArchive[]
  groupMembers  GroupMember[]
}

model Group {
  id           String        @id @default(uuid())
  name         String
  type         String        @default("GROCERY")
  createdAt    DateTime      @default(now())
  members      GroupMember[]
  groceryLists GroceryList[]
  groceryItems GroceryItem[] // <-- ADD THIS
  debts        Debt[]
}

model GroupMember {
  id        String   @id @default(uuid())
  userId    String?  // <-- MAKE OPTIONAL (for pending email invites)
  groupId   String
  email     String   // <-- ADD THIS (to track who was invited)
  name      String?  // <-- ADD THIS (display name)
  role      String   @default("member") // "owner" or "member"
  status    String   @default("joined") // "joined" or "invited"
  
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Remove the old @@unique([userId, groupId]) since userId can be null now
  @@unique([email, groupId]) // Prevent inviting the same email twice to a group
}

model Task {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  priority      Priority  @default(MEDIUM)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  isRecurring   Boolean   @default(false)
  repeatInterval String?  // <-- ADD THIS: "daily", "weekly", or "monthly"
  repeatCount   Int       @default(0)
  currentStreak Int       @default(0)
  nextDueDate   DateTime  @default(now())
  createdAt     DateTime  @default(now())
}

model GroceryList {
  id          String        @id @default(uuid())
  groupId     String?
  group       Group?        @relation(fields: [groupId], references: [id])
  title       String
  totalCost   Float         @default(0.0)
  createdAt   DateTime      @default(now())
  items       GroceryItem[]
  expenseId   String?       @unique
  expense     Expense?      @relation(fields: [expenseId], references: [id])
}

model GroceryItem {
  id            String          @id @default(uuid())
  userId        String          
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  groceryListId String?         
  groceryList   GroceryList?    @relation(fields: [groceryListId], references: [id], onDelete: Cascade)
  
  groupId       String?         // <-- ADD THIS (Links item directly to the shared group)
  group         Group?          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addedByName   String?         // <-- ADD THIS (To display "added by Jordan" in UI)

  name          String
  priority      Priority        @default(MEDIUM) 
  category      GroceryCategory @default(OTHER)
  quantity      Int             @default(1)
  amount        Float?          
  buyDate       DateTime        @default(now())
  isBought      Boolean         @default(false)
  boughtAt      DateTime?       
  createdAt     DateTime        @default(now())
}

model Debt {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id])
  type        DebtType  // OWED_TO_ME or I_OWE_OTHERS
  personName  String
  amount      Float
  description String?
  isSettled   Boolean   @default(false)
  date        DateTime  @default(now()) // <-- ADDED THIS
  settledAt   DateTime?                 // <-- ADDED THIS
  createdAt   DateTime  @default(now())
  expenseId   String?   @unique
  expense     Expense?  @relation(fields: [expenseId], references: [id])
}

model BillArchive {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  s3Url       String
  vendorName  String?
  amount      Float      @default(0.0)
  
  receiptDate DateTime?  // <-- CHANGE 1: Catch the Textract printed date
  createdAt   DateTime   @default(now())
  
  items       BillItem[] // <-- CHANGE 2: Link to the line items
  
  expenseId   String?    @unique
  expense     Expense?   @relation(fields: [expenseId], references: [id])
}

// <-- CHANGE 3: Create the new model to hold the categorized line items
model BillItem {
  id            String          @id @default(uuid())
  billArchiveId String
  billArchive   BillArchive     @relation(fields: [billArchiveId], references: [id], onDelete: Cascade)
  
  name          String
  amount        Float
  category      GroceryCategory @default(OTHER)
  quantity      Int             @default(1)
  
  createdAt     DateTime        @default(now())
}

model Expense {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  category      String
  description   String
  date          DateTime     @default(now())
  groceryList   GroceryList?
  debt          Debt?
  billArchive   BillArchive?
}
